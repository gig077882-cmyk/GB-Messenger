# Rendered by entrypoint.sh; do not place secrets in this file.
listening-port=3478
fingerprint
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}
realm=${TURN_REALM}
external-ip=${TURN_EXTERNAL_IP}
min-port=49160
max-port=49200
no-cli
no-tls
no-dtls
no-loopback-peers
no-multicast-peers
stale-nonce=600
user-quota=12
total-quota=180
# Three-person mesh calls; client traffic is limited by relay bandwidth where supported.
max-bps=3000000
bps-capacity=9000000
