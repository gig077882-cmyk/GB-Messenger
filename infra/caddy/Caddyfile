{
	# Caddy obtains a public certificate when DOMAIN is a resolvable public name.
	# `caddy run --envfile` expands {$DOMAIN}; localhost receives Caddy's local CA.
	email {$ACME_EMAIL}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	@api path /api/*
	reverse_proxy @api backend:3000

	@ws path /ws /ws/*
	reverse_proxy @ws backend:3000

	reverse_proxy frontend:80
}
