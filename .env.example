# Copy to .env and replace all placeholder values. Never commit .env.
NODE_ENV=production
DOMAIN=chat.example.com
ACME_EMAIL=admin@example.com
HOST=0.0.0.0
PORT=3000
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=true
MAX_USERS=60
MAX_FILE_BYTES=5368709120
UPLOAD_CHUNK_BYTES=8388608
FILE_RETENTION_HOURS=72
MAX_STORAGE_BYTES=322122547200
MIN_FREE_BYTES=53687091200
TURN_REALM=chat.example.com
TURN_EXTERNAL_IP=203.0.113.10
TURN_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_TURN_SECRET
BACKUP_INTERVAL_SECONDS=86400
TURN_HOST=your.domain.com
